            {
              "id": "1a3d1fa",
              "elType": "widget",
              "widgetType": "html",
              "isInner": false,
              "settings": {
                "html": "<!-- ============================================================\n  F&A Hospitality Calculators — Elementor HTML widget version\n  Paste this WHOLE file into one Elementor \"HTML\" widget.\n  Everything is scoped to .fac so it won't clash with the theme.\n  Rates: UK 2026/27 (from 6 April 2026). Update the R object below each April.\n============================================================= -->\n<style>\n.fac{--navy:#123560;--navy-dark:#0A1E38;--navy-light:#1C4880;--orange:#E96C20;--orange-hover:#D55D15;--orange-soft:#FFF5EE;--teal:#00B67A;--warn:#C2410C;--bg:#F8FAFC;--surface:#FFFFFF;--ink:#1E293B;--muted:#64748B;--lead:#475569;--border:#E2E8F0;--field:#F8FAFC;\n  --display:\"Plus Jakarta Sans\",ui-sans-serif,system-ui,sans-serif;--body:\"Inter\",ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;--ease:cubic-bezier(.16,1,.3,1);\n  font-family:var(--body);font-size:15px;line-height:1.6;color:var(--ink);text-align:left;max-width:1172px;margin:0 auto}\n.fac *{box-sizing:border-box}\n/* neutralise theme button/input styles */\n.fac button,.fac button:hover,.fac button:focus{border:0;background:none;color:inherit;text-transform:none;letter-spacing:normal;box-shadow:none;margin:0;min-height:0;line-height:1.2;text-decoration:none}\n.fac input,.fac select{margin:0;box-shadow:none;height:auto;line-height:1.3}\n.fac h2{font-family:var(--display);font-weight:800;font-size:26px;letter-spacing:-.6px;margin:0 0 6px;line-height:1.2;color:var(--ink);text-transform:none}\n.fac p{margin:0}\n.fac ul{margin:0}\n\n.fac .fac-tabs{display:flex;gap:6px;background:var(--navy);padding:6px;border-radius:14px;overflow-x:auto;margin-bottom:32px}\n.fac .fac-tab{cursor:pointer;font:600 15px/1 var(--body);padding:14px 20px;border-radius:10px;color:#AFC0D6;white-space:nowrap;flex:1;transition:background .3s var(--ease),color .3s var(--ease)}\n.fac .fac-tab:hover{color:#fff;background:rgba(255,255,255,.1)}\n.fac .fac-tab[aria-selected=\"true\"]{background:#fff;color:var(--navy)}\n.fac button:focus-visible,.fac input:focus-visible,.fac select:focus-visible{outline:2px solid var(--orange);outline-offset:2px}\n\n.fac .fac-calc{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:32px;align-items:start}\n.fac [hidden]{display:none!important}\n@media (max-width:860px){.fac .fac-calc{grid-template-columns:1fr}}\n.fac .fac-intro{color:var(--lead);margin:0 0 24px;max-width:56ch}\n.fac .fac-fields{display:grid;gap:18px}\n.fac .fac-row2{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n@media (max-width:480px){.fac .fac-row2{grid-template-columns:1fr}}\n.fac label{display:block;font-weight:600;font-size:13.5px;margin:0 0 6px;color:var(--ink)}\n.fac .fac-hint{font-weight:400;color:var(--muted);font-size:12.5px}\n.fac .fac-money{position:relative}\n.fac .fac-money span{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:500;pointer-events:none}\n.fac input[type=number],.fac select{width:100%;font:500 16px var(--body);color:var(--ink);background:var(--field);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-variant-numeric:tabular-nums}\n.fac .fac-money input{padding-left:30px}\n.fac .fac-seg{display:flex;background:var(--field);border:1px solid var(--border);border-radius:10px;padding:4px;gap:4px;flex-wrap:wrap}\n.fac .fac-seg button{flex:1;color:var(--muted);font:600 14px var(--body);padding:9px 10px;border-radius:7px;cursor:pointer;white-space:nowrap}\n.fac .fac-seg button[aria-pressed=\"true\"]{background:var(--surface);color:var(--ink);box-shadow:0 1px 3px rgba(18,53,96,.15)}\n.fac .fac-check{display:flex;gap:10px;align-items:flex-start;font-weight:500;font-size:14px;cursor:pointer}\n.fac .fac-check input{width:18px;height:18px;margin-top:2px;accent-color:var(--orange);flex:none}\n\n.fac .fac-result{background:var(--surface);border:1px solid var(--border);border-radius:18px;box-shadow:0 10px 30px -12px rgba(18,53,96,.18);overflow:hidden}\n.fac .fac-headline{padding:26px 28px 22px;border-bottom:1px solid var(--border)}\n.fac .fac-lbl{font-size:12.5px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted)}\n.fac .fac-big{font-family:var(--display);font-weight:800;font-size:clamp(34px,6vw,46px);letter-spacing:-1.2px;line-height:1.1;margin-top:6px;font-variant-numeric:tabular-nums;color:var(--navy)}\n.fac .fac-sub{color:var(--lead);font-size:14px;margin-top:4px}\n.fac .fac-lines{list-style:none;padding:10px 28px 18px}\n.fac .fac-lines li{display:flex;justify-content:space-between;gap:16px;padding:10px 0;margin:0;border-bottom:1px dashed var(--border);font-variant-numeric:tabular-nums}\n.fac .fac-lines li:last-child{border-bottom:0}\n.fac .fac-lines li b{font-weight:600}\n.fac .fac-lines li.total{border-top:1px solid var(--ink);border-bottom:0;margin-top:4px;font-weight:700}\n.fac .fac-lines .neg{color:var(--muted)}\n.fac .fac-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1px;background:var(--border)}\n.fac .fac-kpi{background:var(--surface);padding:18px 22px}\n.fac .fac-kpi .v{font-family:var(--display);font-weight:800;font-size:28px;letter-spacing:-.6px;font-variant-numeric:tabular-nums;color:var(--navy)}\n.fac .fac-kpi .n{font-size:13px;color:var(--muted);font-weight:500}\n.fac .fac-pill{display:inline-block;font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px;margin-top:6px}\n.fac .fac-pill.good{background:#E6F8F1;color:#00875A}\n.fac .fac-pill.watch{background:#FFEDD5;color:var(--warn)}\n.fac .fac-pill.none{background:var(--field);color:var(--muted)}\n.fac .fac-note{padding:16px 28px 22px;background:var(--orange-soft);font-size:13.5px;color:var(--lead);border-top:1px solid var(--border)}\n.fac .fac-note strong{color:var(--ink)}\n.fac .fac-bar{height:10px;border-radius:999px;background:var(--field);border:1px solid var(--border);overflow:hidden;margin:0 28px 6px;display:flex}\n.fac .fac-bar i{display:block;height:100%}\n.fac .fac-legend{display:flex;flex-wrap:wrap;gap:14px;margin:8px 28px 4px;font-size:12.5px;color:var(--muted)}\n.fac .fac-legend span::before{content:\"\";display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:6px;background:var(--c)}\n.fac .fac-small{font-size:12.5px;color:var(--muted);margin-top:24px}\n@media (prefers-reduced-motion:reduce){.fac *{transition:none!important}}\n</style>\n\n<div class=\"fac\" id=\"fac\">\n  <div class=\"fac-tabs\" role=\"tablist\" aria-label=\"Calculators\">\n    <button type=\"button\" class=\"fac-tab\" role=\"tab\" data-t=\"vat\">VAT calculator</button>\n    <button type=\"button\" class=\"fac-tab\" role=\"tab\" data-t=\"gp\">GP% &amp; prime cost</button>\n    <button type=\"button\" class=\"fac-tab\" role=\"tab\" data-t=\"payroll\">Payroll cost</button>\n  </div>\n\n  <!-- VAT -->\n  <section class=\"fac-calc\" data-panel=\"vat\" role=\"tabpanel\">\n    <div>\n      <h2>VAT calculator</h2>\n      <p class=\"fac-intro\">Add VAT to a net price, or take VAT out of a menu price. Hot takeaway food and eat-in sales are 20%; cold takeaway food is usually 0%.</p>\n      <div class=\"fac-fields\">\n        <div><label>What do you want to do?</label>\n          <div class=\"fac-seg\" data-seg=\"vatmode\">\n            <button type=\"button\" data-v=\"remove\" aria-pressed=\"true\">Remove VAT (from gross)</button>\n            <button type=\"button\" data-v=\"add\" aria-pressed=\"false\">Add VAT (to net)</button>\n          </div></div>\n        <div><label for=\"fac-vat-amount\" data-el=\"vatlbl\">Price including VAT</label>\n          <div class=\"fac-money\"><span>£</span><input id=\"fac-vat-amount\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"0.01\" value=\"14.50\"></div></div>\n        <div><label for=\"fac-vat-rate\">VAT rate</label>\n          <select id=\"fac-vat-rate\">\n            <option value=\"20\" selected>20% Standard (eat-in, hot takeaway, alcohol)</option>\n            <option value=\"5\">5% Reduced</option>\n            <option value=\"0\">0% Zero (most cold takeaway food)</option>\n          </select></div>\n        <div><label for=\"fac-vat-qty\">Quantity <span class=\"fac-hint\">· e.g. covers or items sold</span></label>\n          <input id=\"fac-vat-qty\" type=\"number\" inputmode=\"numeric\" min=\"1\" step=\"1\" value=\"1\"></div>\n      </div>\n    </div>\n    <div class=\"fac-result\" aria-live=\"polite\">\n      <div class=\"fac-headline\"><div class=\"fac-lbl\">VAT amount</div><div class=\"fac-big\" data-el=\"vatbig\"></div><div class=\"fac-sub\" data-el=\"vatsub\"></div></div>\n      <ul class=\"fac-lines\" data-el=\"vatlines\"></ul>\n      <p class=\"fac-note\"><strong>Tip:</strong> the same burger can carry different VAT. Eaten in, it is 20%. Taken away hot, also 20%. A cold sandwich to take away is usually 0%. Getting the till set up right protects your margin.</p>\n    </div>\n  </section>\n\n  <!-- GP -->\n  <section class=\"fac-calc\" data-panel=\"gp\" role=\"tabpanel\" hidden>\n    <div>\n      <h2>GP% and prime cost</h2>\n      <p class=\"fac-intro\">Enter one week or one month of figures. Use sales excluding VAT, since VAT is not your money.</p>\n      <div class=\"fac-fields\">\n        <div class=\"fac-row2\">\n          <div><label for=\"fac-fsales\">Food sales <span class=\"fac-hint\">ex VAT</span></label><div class=\"fac-money\"><span>£</span><input id=\"fac-fsales\" type=\"number\" inputmode=\"decimal\" min=\"0\" value=\"18500\"></div></div>\n          <div><label for=\"fac-fcost\">Food purchases</label><div class=\"fac-money\"><span>£</span><input id=\"fac-fcost\" type=\"number\" inputmode=\"decimal\" min=\"0\" value=\"5920\"></div></div>\n        </div>\n        <div class=\"fac-row2\">\n          <div><label for=\"fac-dsales\">Drink sales <span class=\"fac-hint\">ex VAT</span></label><div class=\"fac-money\"><span>£</span><input id=\"fac-dsales\" type=\"number\" inputmode=\"decimal\" min=\"0\" value=\"9200\"></div></div>\n          <div><label for=\"fac-dcost\">Drink purchases</label><div class=\"fac-money\"><span>£</span><input id=\"fac-dcost\" type=\"number\" inputmode=\"decimal\" min=\"0\" value=\"2850\"></div></div>\n        </div>\n        <div><label for=\"fac-labour\">Labour cost <span class=\"fac-hint\">· wages, employer NI and pension</span></label><div class=\"fac-money\"><span>£</span><input id=\"fac-labour\" type=\"number\" inputmode=\"decimal\" min=\"0\" value=\"8900\"></div></div>\n        <label class=\"fac-check\"><input type=\"checkbox\" id=\"fac-incvat\"> My sales figures include VAT at 20% (remove it for me)</label>\n      </div>\n    </div>\n    <div class=\"fac-result\" aria-live=\"polite\">\n      <div class=\"fac-headline\"><div class=\"fac-lbl\">Prime cost</div><div class=\"fac-big\" data-el=\"gpbig\"></div><div class=\"fac-sub\" data-el=\"gpsub\"></div><span class=\"fac-pill none\" data-el=\"gppill\"></span></div>\n      <div class=\"fac-kpis\">\n        <div class=\"fac-kpi\"><div class=\"n\">Food GP</div><div class=\"v\" data-el=\"kfood\"></div><span class=\"fac-pill none\" data-el=\"pfood\"></span></div>\n        <div class=\"fac-kpi\"><div class=\"n\">Drink GP</div><div class=\"v\" data-el=\"kdrink\"></div><span class=\"fac-pill none\" data-el=\"pdrink\"></span></div>\n        <div class=\"fac-kpi\"><div class=\"n\">Overall GP</div><div class=\"v\" data-el=\"kall\"></div></div>\n      </div>\n      <div style=\"padding-top:18px\">\n        <div class=\"fac-bar\" data-el=\"gpbar\"></div>\n        <div class=\"fac-legend\"><span style=\"--c:#1C4880\">Food &amp; drink cost</span><span style=\"--c:#E96C20\">Labour</span><span style=\"--c:#00B67A\">Left for rent, bills and profit</span></div>\n      </div>\n      <ul class=\"fac-lines\" data-el=\"gplines\"></ul>\n      <p class=\"fac-note\"><strong>Rule of thumb:</strong> many UK restaurants aim for food GP around 65–70%, drinks around 70% or more, and prime cost under 60–65% of sales. Your targets depend on your concept.</p>\n    </div>\n  </section>\n\n  <!-- Payroll -->\n  <section class=\"fac-calc\" data-panel=\"payroll\" role=\"tabpanel\" hidden>\n    <div>\n      <h2>Payroll cost estimate</h2>\n      <p class=\"fac-intro\">See what an employee takes home and what they really cost you. 2026/27 rates, England, Wales and NI, tax code 1257L.</p>\n      <div class=\"fac-fields\">\n        <div><label>Pay type</label>\n          <div class=\"fac-seg\" data-seg=\"paymode\">\n            <button type=\"button\" data-v=\"hourly\" aria-pressed=\"true\">Hourly</button>\n            <button type=\"button\" data-v=\"annual\" aria-pressed=\"false\">Annual salary</button>\n          </div></div>\n        <div class=\"fac-row2\" data-el=\"payhourly\">\n          <div><label for=\"fac-rate\">Hourly rate</label><div class=\"fac-money\"><span>£</span><input id=\"fac-rate\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"0.01\" value=\"12.71\"></div></div>\n          <div><label for=\"fac-hours\">Hours per week</label><input id=\"fac-hours\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"0.5\" value=\"35\"></div>\n        </div>\n        <div data-el=\"payannual\" hidden>\n          <label for=\"fac-salary\">Annual salary</label><div class=\"fac-money\"><span>£</span><input id=\"fac-salary\" type=\"number\" inputmode=\"decimal\" min=\"0\" step=\"100\" value=\"32000\"></div>\n        </div>\n        <p class=\"fac-hint\" data-el=\"paynlw\" style=\"margin-top:-8px\"></p>\n        <label class=\"fac-check\"><input type=\"checkbox\" id=\"fac-pension\" checked> Include workplace pension (5% employee, 3% employer, on qualifying earnings)</label>\n        <label class=\"fac-check\"><input type=\"checkbox\" id=\"fac-ea\"> We claim Employment Allowance (up to £10,500 off employer NI a year)</label>\n      </div>\n    </div>\n    <div class=\"fac-result\" aria-live=\"polite\">\n      <div class=\"fac-kpis\">\n        <div class=\"fac-kpi\"><div class=\"n\">Employee takes home</div><div class=\"v\" data-el=\"paytake\"></div><div class=\"fac-sub\" data-el=\"paytakem\"></div></div>\n        <div class=\"fac-kpi\"><div class=\"n\">Total cost to you</div><div class=\"v\" data-el=\"paycost\"></div><div class=\"fac-sub\" data-el=\"paycostm\"></div></div>\n      </div>\n      <ul class=\"fac-lines\" data-el=\"paylines\"></ul>\n      <p class=\"fac-note\"><strong>Estimate only.</strong> Assumes one job, no student loan, no benefits in kind, and pension under a net pay arrangement. Scottish rates differ. Employment Allowance is shared across your whole payroll.</p>\n    </div>\n  </section>\n\n  <p class=\"fac-small\">These calculators give estimates for guidance only and are not tax advice. Rates from HMRC's rates and thresholds for employers 2026 to 2027.</p>\n</div>\n\n<script>\n(function () {\n  var root = document.getElementById(\"fac\"); if (!root) return;\n  var $ = function (id) { return document.getElementById(id); };\n  var el = function (k) { return root.querySelector('[data-el=\"' + k + '\"]'); };\n  var num = function (id) { return Math.max(0, parseFloat($(id).value) || 0); };\n  var gbp = function (n, dp) { dp = dp == null ? 2 : dp; return (n < 0 ? \"−\" : \"\") + \"£\" + Math.abs(n).toLocaleString(\"en-GB\", { minimumFractionDigits: dp, maximumFractionDigits: dp }); };\n  var pct = function (n) { return isFinite(n) ? n.toFixed(1) + \"%\" : \"–\"; };\n  var li = function (a, b, cls) { return '<li class=\"' + (cls || \"\") + '\"><span>' + a + \"</span><b>\" + b + \"</b></li>\"; };\n  var on = function (ids, fn) { ids.forEach(function (id) { $(id).addEventListener(\"input\", fn); $(id).addEventListener(\"change\", fn); }); };\n  function seg(name, cb) {\n    var s = root.querySelector('[data-seg=\"' + name + '\"]');\n    s.addEventListener(\"click\", function (e) {\n      var b = e.target.closest(\"button\"); if (!b) return;\n      s.querySelectorAll(\"button\").forEach(function (x) { x.setAttribute(\"aria-pressed\", x === b); });\n      cb(b.dataset.v);\n    });\n    return function () { return s.querySelector('[aria-pressed=\"true\"]').dataset.v; };\n  }\n\n  // Tabs\n  var tabs = root.querySelectorAll(\".fac-tab\");\n  function show(t) {\n    tabs.forEach(function (b) { b.setAttribute(\"aria-selected\", b.dataset.t === t); });\n    root.querySelectorAll(\"[data-panel]\").forEach(function (p) { p.hidden = p.dataset.panel !== t; });\n  }\n  tabs.forEach(function (b) { b.addEventListener(\"click\", function () { show(b.dataset.t); }); });\n  var h = location.hash.replace(\"#\", \"\");\n  show([\"vat\", \"gp\", \"payroll\"].indexOf(h) > -1 ? h : \"vat\");\n\n  // VAT\n  var vatMode = seg(\"vatmode\", function (m) { el(\"vatlbl\").textContent = m === \"add\" ? \"Price excluding VAT\" : \"Price including VAT\"; vat(); });\n  function vat() {\n    var amt = num(\"fac-vat-amount\"), r = num(\"fac-vat-rate\") / 100, q = Math.max(1, Math.round(num(\"fac-vat-qty\")) || 1), net, gross;\n    if (vatMode() === \"add\") { net = amt; gross = amt * (1 + r); } else { gross = amt; net = amt / (1 + r); }\n    var v = gross - net;\n    el(\"vatbig\").textContent = gbp(v * q);\n    el(\"vatsub\").textContent = q > 1 ? gbp(v) + \" per item × \" + q : \"at \" + r * 100 + \"% VAT\";\n    el(\"vatlines\").innerHTML = li(\"Net (excluding VAT)\", gbp(net * q)) + li(\"VAT at \" + r * 100 + \"%\", gbp(v * q)) + li(\"Gross (including VAT)\", gbp(gross * q), \"total\");\n  }\n  on([\"fac-vat-amount\", \"fac-vat-rate\", \"fac-vat-qty\"], vat);\n\n  // GP\n  function rate(p, val, goal, higherIsGood) {\n    if (!isFinite(val)) { p.className = \"fac-pill none\"; p.textContent = \"No sales\"; return; }\n    var ok = higherIsGood ? val >= goal : val <= goal;\n    p.className = \"fac-pill \" + (ok ? \"good\" : \"watch\"); p.textContent = ok ? \"On target\" : \"Worth a look\";\n  }\n  function gp() {\n    var k = $(\"fac-incvat\").checked ? 1 / 1.2 : 1;\n    var fs = num(\"fac-fsales\") * k, ds = num(\"fac-dsales\") * k, fc = num(\"fac-fcost\"), dc = num(\"fac-dcost\"), lab = num(\"fac-labour\");\n    var sales = fs + ds, cogs = fc + dc, prime = cogs + lab;\n    var fgp = (fs - fc) / fs * 100, dgp = (ds - dc) / ds * 100, agp = (sales - cogs) / sales * 100, pp = prime / sales * 100;\n    el(\"kfood\").textContent = pct(fgp); el(\"kdrink\").textContent = pct(dgp); el(\"kall\").textContent = pct(agp);\n    rate(el(\"pfood\"), fgp, 65, true); rate(el(\"pdrink\"), dgp, 70, true);\n    el(\"gpbig\").textContent = pct(pp); el(\"gpsub\").textContent = gbp(prime, 0) + \" of \" + gbp(sales, 0) + \" sales\";\n    rate(el(\"gppill\"), pp, 65, false);\n    var w = function (x) { return sales > 0 ? Math.max(0, Math.min(100, x / sales * 100)) : 0; };\n    var cw = w(cogs), lw = Math.min(w(lab), 100 - cw);\n    el(\"gpbar\").innerHTML = '<i style=\"width:' + cw + '%;background:#1C4880\"></i><i style=\"width:' + lw + '%;background:#E96C20\"></i><i style=\"width:' + (100 - cw - lw) + '%;background:#00B67A\"></i>';\n    el(\"gplines\").innerHTML = li(\"Total sales (ex VAT)\", gbp(sales, 0)) + li(\"Food & drink cost\", gbp(cogs, 0)) + li(\"Gross profit\", gbp(sales - cogs, 0)) + li(\"Labour cost\", gbp(lab, 0)) + li(\"Left after prime cost\", gbp(sales - prime, 0), \"total\");\n  }\n  on([\"fac-fsales\", \"fac-fcost\", \"fac-dsales\", \"fac-dcost\", \"fac-labour\", \"fac-incvat\"], gp);\n\n  // Payroll — UK 2026/27 (England, Wales, NI). Update each April.\n  var R = { pa: 12570, basic: 37700, addl: 125140, taper: 100000, pt: 12570, uel: 50270, st: 5000, eeNI: .08, eeNI2: .02, erNI: .15, ea: 10500, qeLo: 6240, qeHi: 50270, eePen: .05, erPen: .03, nlw: 12.71 };\n  function incomeTax(inc) {\n    var pa = Math.max(0, R.pa - Math.max(0, inc - R.taper) / 2), t = Math.max(0, inc - pa);\n    return Math.min(t, R.basic) * .2 + Math.min(Math.max(t - R.basic, 0), R.addl - R.basic) * .4 + Math.max(t - R.addl, 0) * .45;\n  }\n  var payMode = seg(\"paymode\", function (m) { el(\"payhourly\").hidden = m !== \"hourly\"; el(\"payannual\").hidden = m !== \"annual\"; pay(); });\n  function pay() {\n    var hourly = payMode() === \"hourly\";\n    var g = hourly ? num(\"fac-rate\") * num(\"fac-hours\") * 52 : num(\"fac-salary\");\n    var qe = $(\"fac-pension\").checked ? Math.max(0, Math.min(g, R.qeHi) - R.qeLo) : 0;\n    var eePen = qe * R.eePen, erPen = qe * R.erPen, tax = incomeTax(g - eePen);\n    var eeNI = Math.max(0, Math.min(g, R.uel) - R.pt) * R.eeNI + Math.max(0, g - R.uel) * R.eeNI2;\n    var erFull = Math.max(0, g - R.st) * R.erNI, eaUsed = $(\"fac-ea\").checked ? Math.min(erFull, R.ea) : 0;\n    var take = g - tax - eeNI - eePen, cost = g + erFull - eaUsed + erPen;\n    var n = el(\"paynlw\");\n    if (hourly) {\n      var low = num(\"fac-rate\") < R.nlw;\n      n.textContent = low ? \"Below the £\" + R.nlw + \" National Living Wage for workers aged 21+. Check the right rate for this employee's age.\" : \"Annual pay: \" + gbp(g, 0) + \" (\" + num(\"fac-hours\") + \" hrs × 52 weeks)\";\n      n.style.color = low ? \"#C2410C\" : \"\";\n    } else n.textContent = \"\";\n    el(\"paytake\").textContent = gbp(take, 0); el(\"paytakem\").textContent = gbp(take / 12) + \" a month\";\n    el(\"paycost\").textContent = gbp(cost, 0); el(\"paycostm\").textContent = gbp(cost / 12) + \" a month\";\n    el(\"paylines\").innerHTML = li(\"Gross pay\", gbp(g)) + li(\"Income tax\", \"− \" + gbp(tax), \"neg\") + li(\"Employee NI (8% / 2%)\", \"− \" + gbp(eeNI), \"neg\") +\n      li(\"Employee pension (5%)\", \"− \" + gbp(eePen), \"neg\") + li(\"Take-home pay\", gbp(take), \"total\") + li(\"Employer NI (15% over £5,000)\", \"+ \" + gbp(erFull)) +\n      (eaUsed ? li(\"Employment Allowance\", \"− \" + gbp(eaUsed), \"neg\") : \"\") + li(\"Employer pension (3%)\", \"+ \" + gbp(erPen)) + li(\"Total cost to employer\", gbp(cost), \"total\");\n  }\n  on([\"fac-rate\", \"fac-hours\", \"fac-salary\", \"fac-pension\", \"fac-ea\"], pay);\n\n  vat(); gp(); pay();\n})();\n</script>\n",
                "_title": "F&A – Calculators embed"
              },
              "elements": []
            }
          ]
        }
      ]
    },
